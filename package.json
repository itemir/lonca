{
  "name": "lonca",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A coordinator that lets you run a team of Claude, Codex and Gemini coding agents from your browser. Each workspace gets an isolated virtual machine to reduce security risks.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node scripts/start.ts",
    "dev": "node scripts/dev.ts",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "vitest run",
    "test:docker": "vitest run --config vitest.docker.config.ts",
    "test:sandbox": "LONCA_TEST_RUNTIME=sandbox vitest run --config vitest.docker.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "express": "^5.3.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  }
}
