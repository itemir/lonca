#!/bin/bash
# Runs as root with just enough capability to install the firewall, then drops
# to the unprivileged user for good. Refuses to start if the firewall can't be
# applied: a workspace must never silently come up without its isolation.
set -euo pipefail

# The host, the LAN, other containers, cloud metadata, and the reserved ranges that
# VPNs and virtual networks use.
BLOCKED_V4="0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.168.0.0/16 198.18.0.0/15 224.0.0.0/4 240.0.0.0/4"
BLOCKED_V6="fc00::/7 fe80::/10 ::ffff:0:0/96"

# Docker's names for the host can point outside those ranges.
host_addresses() {
  local name
  for name in host.docker.internal gateway.docker.internal; do
    timeout 2 getent ahosts "$name" 2>/dev/null | awk '{ print $1 }' || true
  done | sort -u
}

# The `if` that calls this suspends `set -e`, so every rule checks for failure itself.
apply_firewall() {
  local ipt=$1 ip6t=$2 target
  "$ipt" -A OUTPUT -o lo -j ACCEPT || return 1
  "$ipt" -A OUTPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT || return 1
  for target in $BLOCKED_V4 $(host_addresses | grep -v : || true); do
    "$ipt" -A OUTPUT -d "$target" -j REJECT || return 1
  done
  # Docker turns IPv6 off in the container on networks that don't use it.
  [ "$(cat /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null || echo 1)" = 1 ] && return 0
  "$ip6t" -A OUTPUT -o lo -j ACCEPT || return 1
  "$ip6t" -A OUTPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT || return 1
  for target in $BLOCKED_V6 $(host_addresses | grep : || true); do
    "$ip6t" -A OUTPUT -d "$target" -j REJECT || return 1
  done
}

if [ "${LONCA_NETWORK:-internet}" = "internet" ]; then
  if ! apply_firewall iptables ip6tables 2>/dev/null; then
    iptables -F OUTPUT 2>/dev/null || true
    ip6tables -F OUTPUT 2>/dev/null || true
    if ! apply_firewall iptables-legacy ip6tables-legacy 2>/dev/null; then
      echo "lonca: could not install the network firewall" >&2
      exit 78
    fi
  fi
fi

uid=$(id -u lonca)
gid=$(id -g lonca)
export HOME=/home/lonca
exec setpriv --reuid="$uid" --regid="$gid" --clear-groups --inh-caps=-all --no-new-privs \
  bash -c '
    # An exited agent can still have output Lonca has not saved, so only Lonca
    # may retire its output directory.
    rm -rf /var/tmp/lonca/tty
    mkdir -p /var/tmp/lonca/tty
    # `codex login` replaces this link with a private file; keep that login by sharing it.
    auth="$HOME/.codex/auth.json"
    shared=/var/lib/lonca/credentials/codex/auth.json
    if [ -f "$auth" ] && [ ! -L "$auth" ]; then mv -f "$auth" "$shared"; fi
    [ -L "$auth" ] || ln -sfn "$shared" "$auth"
    touch /run/lonca/ready
    exec "$@"
  ' lonca-entrypoint "$@"
