#!/bin/bash
# lonca-share-codex-login <shared auth.json>
# Also sent inline by the server, so older workspace images use the same rules.
set -e
auth="$HOME/.codex/auth.json"
shared="$1"

# A browser login can include an API key that Codex doesn't use with ChatGPT.
# Write beside the destination, so readers never see a half-written credential.
sanitize_login() {
  local source="$1" target="$2" replacement
  replacement=$(mktemp "${target}.XXXXXX") || return 1
  if jq -ce 'if .auth_mode == "chatgpt" then .OPENAI_API_KEY = null else . end' "$source" > "$replacement" \
    && chmod --reference="$source" "$replacement" \
    && mv -f "$replacement" "$target"; then
    return 0
  fi
  rm -f "$replacement"
  return 1
}

# The CLI replaces the symlink when it signs in. Don't share a file it didn't
# finish writing; restore the link to the existing login instead.
if [ -f "$auth" ] && [ ! -L "$auth" ]; then
  if command -v jq > /dev/null; then
    if sanitize_login "$auth" "$shared"; then rm -f "$auth"; fi
  else
    # Older custom images can lack jq. Keep their manually configured login.
    mv -f "$auth" "$shared"
  fi
fi
[ -L "$auth" ] || ln -sfn "$shared" "$auth"

# An older entrypoint may already have shared the file and restored the link.
# Leave ordinary logins untouched, including keys configured on purpose.
if command -v jq > /dev/null && [ -f "$shared" ] \
  && jq -e '.auth_mode == "chatgpt" and .OPENAI_API_KEY != null' "$shared" > /dev/null; then
  sanitize_login "$shared" "$shared"
fi
