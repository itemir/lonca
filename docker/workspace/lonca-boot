#!/bin/bash
# lonca-boot <credentials dir> <agent state dir>
# A sandbox doesn't run an entrypoint of ours, so the server runs this after starting one.
set -eu
credentials="$1"
state="$2"

# The Codex login lives on a directory every workspace shares, as it does in a container.
sudo install -d -o agent -g agent /var/lib/lonca
ln -sfn "$credentials" /var/lib/lonca/credentials

mkdir -p "$HOME/.claude" "$HOME/.codex"
[ -e "$HOME/.claude.json" ] || echo '{"hasCompletedOnboarding":true,"bypassPermissionsModeAccepted":true}' > "$HOME/.claude.json"
[ -e "$HOME/.codex/config.toml" ] || echo 'cli_auth_credentials_store = "file"' > "$HOME/.codex/config.toml"

# Rebuilding a workspace replaces its VM, and conversations have to outlive that to be resumed.
mkdir -p "$state/claude-projects" "$state/codex-sessions"
ln -sfn "$state/claude-projects" "$HOME/.claude/projects"
ln -sfn "$state/codex-sessions" "$HOME/.codex/sessions"

# Terminal attachments end at reboot. Agent output survives until Lonca has read
# and saved it.
boot=$(cat /proc/sys/kernel/random/boot_id)
if [ "$(cat /var/tmp/lonca/boot 2>/dev/null)" != "$boot" ]; then
  rm -rf /var/tmp/lonca/tty
  mkdir -p /var/tmp/lonca/tty
  echo "$boot" > /var/tmp/lonca/boot
fi

lonca-share-codex-login /var/lib/lonca/credentials/codex/auth.json
