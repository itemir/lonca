#!/bin/bash
# Stands in for the `sbx` CLI, so Lonca's whole path runs in tests without a Docker account: the
# same commands and output, except that a "sandbox" is a plain Docker container. It can't stand in
# for the VM itself, its network policy, its proxy or virtiofs. Those need the real thing:
# npm run test:sandbox
set -u
state="${FAKE_SBX_DIR:?}"
prefix="lonca-${LONCA_INSTANCE:-}"
marker="dev.lonca.fake-sbx=1"
template_marker="dev.lonca.fake-sbx-template=1"
base=docker/sandbox-templates:shell-docker
relay_marker="dev.lonca.fake-sbx-relay"
filters=(--filter "label=$marker")
relay_filters=(--filter "label=$relay_marker")
if [ -n "${LONCA_INSTANCE:-}" ]; then
  filters+=(--filter "label=dev.lonca.instance=$prefix")
  relay_filters+=(--filter "label=dev.lonca.instance=$prefix")
fi

# A test can cut one server off from Docker Sandboxes, leaving its sandboxes running and the test's
# own commands, which don't name an instance, working.
if [ -n "${LONCA_INSTANCE:-}" ] && [ -e "$state/offline-$LONCA_INSTANCE" ]; then
  echo 'error: cannot connect to sandboxd' >&2
  exit 125
fi

signed_in() {
  if [ -e "$state/signed-out" ]; then
    echo 'error: not signed in to Docker' >&2
    echo '  try: sbx login' >&2
    exit 1
  fi
}

list() {
  printf '['
  local separator=''
  while IFS=$'\t' read -r name status; do
    [ -n "$name" ] || continue
    # A paused one still says it's running, but can't be reached.
    [ "$status" = running ] || [ "$status" = paused ] || status=stopped
    [ "$status" != paused ] || status=running
    printf '%s{"name":"%s","agent":"shell","status":"%s","detached":true}' "$separator" "$name" "$status"
    separator=','
  done < <(docker ps -a "${filters[@]}" --format '{{.Names}}	{{.State}}')
  printf ']\n'
}

templates() {
  docker images --filter "label=$template_marker" --format '{{.Repository}}:{{.Tag}}'
}

# Ports published after a sandbox is made, as "host_ip host_port sandbox_port" lines. Like the real
# one's, they outlive a stop and are published again whenever the sandbox starts. Each is relayed by
# a small container of its own, which reaches the sandbox over Docker's network rather than its
# loopback, so that, as in a VM, only a server listening on 0.0.0.0 can be reached.
ports_file() { echo "$state/ports-$1"; }

relay_name() { echo "$1-port-$2"; }

start_relay() {
  local name=$1 ip=$2 host=$3 port=$4 relay target image
  relay=$(relay_name "$name" "$host")
  [ "$(docker inspect --format '{{.State.Running}}' "$relay" 2>/dev/null)" != true ] || return 0
  docker rm -f "$relay" >/dev/null 2>&1
  target=$(docker inspect --format '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$name")
  image=$(docker inspect --format '{{.Config.Image}}' "$name")
  if ! docker run -d --name "$relay" --label "$relay_marker=$name" --label "dev.lonca.instance=$prefix" \
    --publish "$ip:$host:7000" --entrypoint socat "$image" TCP-LISTEN:7000,fork,reuseaddr "TCP:$target:$port" >/dev/null 2>&1; then
    docker rm -f "$relay" >/dev/null 2>&1
    return 1
  fi
}

stop_relays() {
  docker ps -aq --filter "label=$relay_marker=$1" | xargs -r docker rm -f >/dev/null
}

# Like the real one, it won't start a sandbox when one of its ports has been taken meanwhile.
start_relays() {
  local ip host port
  [ -f "$(ports_file "$1")" ] || return 0
  while read -r ip host port; do
    [ -n "$host" ] || continue
    if ! start_relay "$1" "$ip" "$host" "$port"; then
      stop_relays "$1"
      docker stop -t 1 "$1" >/dev/null
      echo "error: cannot start sandbox: start runtime: request failed: 409 Conflict: republish port: port not available: mapping ports: failed to bind host port $ip:$host: address already in use" >&2
      return 1
    fi
  done < "$(ports_file "$1")"
}

# [HOST_IP:]HOST_PORT:SANDBOX_PORT[/PROTOCOL]. Lonca always names the host port.
parse_spec() {
  local parts=()
  IFS=: read -r -a parts <<< "${1%/*}"
  case ${#parts[@]} in
    2) spec_ip=127.0.0.1; spec_host=${parts[0]}; spec_port=${parts[1]} ;;
    3) spec_ip=${parts[0]}; spec_host=${parts[1]}; spec_port=${parts[2]} ;;
    *) echo "error: the stand-in for sbx needs a host port: $1" >&2; exit 1 ;;
  esac
}

publish_port() {
  parse_spec "$2"
  if grep -qs "^[^ ]* $spec_host " "$(ports_file "$1")"; then
    echo "error: publish ports: request failed: 409 Conflict: port $spec_ip:$spec_host/tcp4 is already published" >&2
    exit 1
  fi
  # Like the real one, it starts a stopped sandbox.
  if [ "$(docker inspect --format '{{.State.Running}}' "$1")" != true ]; then
    echo "ports-start $1" >> "$state/calls.log"
    docker start "$1" >/dev/null || exit 1
    start_relays "$1" || exit 1
  fi
  if ! start_relay "$1" "$spec_ip" "$spec_host" "$spec_port"; then
    echo "error: host $spec_ip:$spec_host is already in use; choose a different host port with --publish" >&2
    exit 1
  fi
  echo "$spec_ip $spec_host $spec_port" >> "$(ports_file "$1")"
  echo "ports $1 --publish $2" >> "$state/calls.log"
  echo "Published $spec_ip:$spec_host -> $spec_port/tcp4"
}

# Like the real one, it doesn't start a stopped sandbox, and isn't bothered by a port that isn't published.
unpublish_port() {
  parse_spec "$2"
  local file kept=() ip host port
  file=$(ports_file "$1")
  while read -r ip host port; do
    [ -n "$host" ] || continue
    if [ "$ip $host $port" = "$spec_ip $spec_host $spec_port" ]; then
      docker rm -f "$(relay_name "$1" "$host")" >/dev/null 2>&1
    else
      kept+=("$ip $host $port")
    fi
  done < <(cat "$file" 2>/dev/null)
  if [ ${#kept[@]} -gt 0 ]; then printf '%s\n' "${kept[@]}" > "$file"; else rm -f "$file"; fi
  echo "ports $1 --unpublish $2" >> "$state/calls.log"
  echo "Unpublish requested for $spec_ip:$spec_host -> $spec_port"
}

# Lonca doesn't list them, so neither does this.
ports() {
  signed_in
  if ! docker inspect "${1:-}" >/dev/null 2>&1; then
    echo "error: sandbox '${1:-}' not found" >&2
    exit 1
  fi
  case "${2:-}" in
    --publish|-p) publish_port "$1" "${3:?}" ;;
    --unpublish) unpublish_port "$1" "${3:?}" ;;
    *) echo "error: the stand-in for sbx only publishes and unpublishes ports" >&2; exit 1 ;;
  esac
}

run_sandbox() {
  signed_in
  local name='' template='' agent='' workdir=''
  local options=() mounts=() denied=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --detach|-d) shift ;;
      --name) name=$2; shift 2 ;;
      --template|-t) template=$2; shift 2 ;;
      --pull|--skills) shift 2 ;;
      --memory|-m) options+=(--memory "$2"); shift 2 ;;
      --cpus) options+=(--cpus "$2"); shift 2 ;;
      --publish|-p) options+=(--publish "$2"); shift 2 ;;
      --deny-network) denied+=("$2"); shift 2 ;;
      -*) echo "error: unknown flag: $1" >&2; exit 1 ;;
      *)
        if [ -z "$agent" ]; then
          agent=$1
        else
          # The first workspace is where commands start, as it is for the real one.
          [ -n "$workdir" ] || workdir=$1
          mounts+=(--volume "$1:$1")
        fi
        shift
        ;;
    esac
  done
  if [ ${#name} -gt 63 ]; then
    echo "error: sandbox name cannot exceed 63 characters: $name" >&2
    exit 1
  fi
  if docker inspect "$name" >/dev/null 2>&1; then
    [ ! -e "$state/slow-start" ] || sleep 2
    if docker start "$name" >/dev/null; then start_relays "$name" || exit 1; fi
    echo "$name"
    return
  fi
  if [ "$template" != "$base" ] && ! templates | grep -qxF "$template"; then
    echo "error: cannot create sandbox: image \"$template\" is not cached locally and pull_policy=never" >&2
    exit 1
  fi
  # Like the real one, it gives a template a second name when a VM is first made from it, which
  # keeps the image after the template's own name has gone.
  if [ "$template" != "$base" ]; then
    docker tag "$template" "sandbox-kit-assembled:$(docker inspect --format '{{.Id}}' "$template" | cksum | cut -d' ' -f1)"
  fi
  # The real one plants a placeholder for its proxy to replace, whether or not it holds any secrets.
  echo "run $name template=$template deny=${denied[*]-} ${options[*]-}" >> "$state/calls.log"
  docker run -d --init --name "$name" --hostname "${name:0:63}" --label "dev.lonca.instance=$prefix" --label "$marker" \
    --add-host host.docker.internal:host-gateway --user agent --workdir "$workdir" --entrypoint sleep \
    --env GH_TOKEN=gho_proxy-managed-placeholder-for-tests00 \
    ${options[@]+"${options[@]}"} ${mounts[@]+"${mounts[@]}"} "$template" infinity >/dev/null || exit 1
  echo "$name"
}

exec_in_sandbox() {
  signed_in
  local flags=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --interactive|-i) flags+=(--interactive); shift ;;
      --user|-u) flags+=(--user "$2"); shift 2 ;;
      --workdir|-w) flags+=(--workdir "$2"); shift 2 ;;
      --env=*) flags+=("$1"); shift ;;
      --env|-e) flags+=(--env "$2"); shift 2 ;;
      -*) echo "error: unknown flag: $1" >&2; exit 125 ;;
      *) break ;;
    esac
  done
  local name=$1
  shift
  if [ "${1:-}" = '--' ]; then shift; fi
  local running
  if ! running=$(docker inspect --format '{{.State.Running}}' "$name" 2>/dev/null); then
    echo "error: sandbox $name not found" >&2
    exit 125
  fi
  if [ "$(docker inspect --format '{{.State.Paused}}' "$name")" = true ]; then
    echo "error: sandbox $name isn't responding" >&2
    exit 125
  fi
  # Like the real one, it starts a stopped sandbox.
  if [ "$running" != true ]; then
    local purpose='command'
    for arg in "$@"; do
      case "$arg" in lonca-process|follow|lonca-boot|lonca-terminal-ready) purpose=$arg ;; esac
    done
    echo "exec-start $name $purpose" >> "$state/calls.log"
    docker start "$name" >/dev/null || exit 125
    start_relays "$name" || exit 125
  fi
  # Like the real one, it gives a command a pipe for stdin even without --interactive.
  if [[ " ${flags[*]-} " != *" --interactive "* ]]; then
    exec docker exec --interactive ${flags[@]+"${flags[@]}"} "$name" "$@" < <(:)
  fi
  exec docker exec ${flags[@]+"${flags[@]}"} "$name" "$@"
}

# Prints what the real one does, then waits for the test: `login-approve` in $FAKE_SBX_DIR signs in,
# `login-deny` fails as the real one does when the page refuses it.
login() {
  local code
  code=$(cat "$state/login-code" 2>/dev/null || echo VKNZ-LBTN)
  echo login >> "$state/calls.log"
  printf 'By logging in, you agree to our Subscription Service Agreement. For more details, see https://www.docker.com/legal/docker-subscription-service-agreement/ \n\n'
  printf 'Your one-time device confirmation code is: %s\n' "$code"
  printf 'Complete sign-in in your browser, then return to this terminal.\n'
  printf 'Open this URL to sign in: https://login.docker.com/activate?user_code=%s\n\n' "$code"
  printf 'Waiting for authentication...\n'
  trap 'echo "error: auth login failed: completing login: context canceled" >&2; exit 1' TERM INT
  while :; do
    if [ -e "$state/login-approve" ]; then
      rm -f "$state/login-approve" "$state/signed-out"
      echo 'Login succeeded'
      exit 0
    fi
    if [ -e "$state/login-deny" ]; then
      rm -f "$state/login-deny"
      echo 'error: auth login failed: completing login: access denied' >&2
      exit 1
    fi
    sleep 0.1
  done
}

# The real one stops every sandbox on the computer. This stops only this server's, when it names
# one, so that servers running alongside it in other tests keep theirs.
logout() {
  if [ "${1:-}" != --force ]; then
    echo 'error: stdin is not a terminal; run this command in a terminal to answer the prompt' >&2
    exit 1
  fi
  signed_in
  echo logout >> "$state/calls.log"
  docker ps -q "${filters[@]}" | xargs -r docker stop -t 1 >/dev/null
  docker ps -aq "${relay_filters[@]}" | xargs -r docker rm -f >/dev/null
  touch "$state/signed-out"
}

command=${1:-}
[ $# -eq 0 ] || shift
case "$command" in
  version) echo 'sbx version v0.51.0 fake' ;;
  diagnose)
    status=$(cat "$state/virtualization" 2>/dev/null || echo pass)
    printf '{"version":"1.0","checks":[{"name":"Virtualization","status":"%s","message":"not supported here","detail":"","hint":"Turn on hardware virtualization"}]}\n' "$status"
    ;;
  ls) signed_in; list ;;
  login) login ;;
  logout) logout "$@" ;;
  run) run_sandbox "$@" ;;
  exec) exec_in_sandbox "$@" ;;
  stop) signed_in; docker stop -t 1 "$1" >/dev/null && stop_relays "$1" ;;
  rm)
    signed_in
    [ "${1:-}" = --force ] && shift
    echo "rm $1" >> "$state/calls.log"
    stop_relays "$1"
    rm -f "$(ports_file "$1")"
    docker rm -f "$1" >/dev/null
    ;;
  ports) ports "$@" ;;
  cp) signed_in; docker cp "$@" ;;
  secret)
    signed_in
    echo "secret $*" >> "$state/calls.log"
    ;;
  policy)
    signed_in
    echo "policy $*" >> "$state/calls.log"
    if [ "${1:-}" = init ] && [ -e "$state/policy" ]; then echo 'error: policy already initialized' >&2; exit 1; fi
    if [ "${1:-}" = init ]; then echo "$2" > "$state/policy"; fi
    ;;
  settings) signed_in; echo true ;;
  template)
    signed_in
    case "${1:-}" in
      ls)
        if [ "${2:-}" = --quiet ] || [ "${2:-}" = -q ]; then
          templates
          exit 0
        fi
        printf '['
        separator=''
        while IFS=$'\t' read -r id repository tag; do
          # Saved over with no VM made from it, it has no name left, which for the real one means it's gone.
          [ "$repository" != '<none>' ] || continue
          printf '%s{"id":"%s","repository":"docker.io/library/%s","tag":"%s"}' "$separator" "$id" "$repository" "$tag"
          separator=','
        done < <(docker images --filter "label=$template_marker" --format '{{.ID}}	{{.Repository}}	{{.Tag}}')
        printf ']\n'
        ;;
      save)
        # Like the real one, it won't save a running sandbox.
        if [ "$(docker inspect --format '{{.State.Running}}' "$2" 2>/dev/null)" = true ]; then
          echo 'error: stdin is not a terminal; run this command in a terminal to answer the prompt' >&2
          exit 1
        fi
        # Like the real one, it needs the image the VM was made from, under the name that VM gave it.
        made_from=$(docker inspect --format '{{.Image}}' "$2" 2>/dev/null)
        if [ "$made_from" != "$(docker inspect --format '{{.Id}}' "$base")" ] \
          && ! docker images --no-trunc --filter 'reference=sandbox-kit-assembled:*' --format '{{.ID}}' | grep -qxF "$made_from"; then
          echo "error: save template: getting base image of $2: not found" >&2
          exit 1
        fi
        docker commit --change "LABEL ${template_marker%%=*}=1" "$2" "$3" >/dev/null || exit 1
        echo "Saved template $3"
        ;;
      rm)
        shift
        [ "${1:-}" = --force ] && shift
        if [ $# -ne 1 ]; then
          echo "error: sbx: 'sbx template rm' requires 1 argument" >&2
          exit 1
        fi
        if ! docker rmi --force "$1" >/dev/null 2>&1; then
          echo "error: cannot remove template \"$1\": no image \"$1\"" >&2
          exit 1
        fi
        ;;
      *) echo "error: unknown template command" >&2; exit 1 ;;
    esac
    ;;
  *) echo "error: unknown command: $command" >&2; exit 1 ;;
esac
